<scroll-view class="ui-page wall-page" scroll-y="true" enable-back-to-top="true">
	<view class="ui-card wall-hero">
		<view class="wall-hero__head">
			<view>
				<text class="ui-title">留言板</text>
			</view>
			<view class="wall-hero__actions">
				<button wx:if="{{isAdmin}}" class="wall-btn" bindtap="goToAdmin">管理面板</button>
				<button class="wall-btn wall-btn--primary" bindtap="goToPost">发布消息</button>
			</view>
		</view>
	</view>

	<view class="ui-card wall-toolbar">
		<view class="wall-tabs">
			<text class="wall-tab {{currentType === 'all' ? 'is-active' : ''}}" bindtap="onTypeChange" data-type="all">全部</text>
			<text class="wall-tab {{currentType === 'general' ? 'is-active' : ''}}" bindtap="onTypeChange" data-type="general">普通</text>
			<text class="wall-tab {{currentType === 'lost_and_found' ? 'is-active' : ''}}" bindtap="onTypeChange" data-type="lost_and_found">失物招领</text>
			<text class="wall-tab {{currentType === 'help' ? 'is-active' : ''}}" bindtap="onTypeChange" data-type="help">求助</text>
		</view>
		<view class="wall-search">
			<input class="wall-search__input" placeholder="搜索内容、地点或标签" bindinput="onSearchInput" value="{{searchKeyword}}" />
			<button class="wall-search__btn" bindtap="onSearch">搜索</button>
		</view>
	</view>

	<view wx:if="{{loading && messages.length === 0}}" class="ui-card ui-card--compact wall-state">正在加载墙面消息...</view>

	<block wx:if="{{messages.length > 0}}">
		<view class="wall-feed">
			<view wx:for="{{messages}}" wx:key="id" class="wall-card ui-card ui-card--quiet" bindtap="goToDetail" data-id="{{item.id}}">
				<view class="wall-card__header">
					<view class="wall-card__author">
						<image class="wall-card__avatar" src="{{item.author_avatar}}" mode="aspectFill"></image>
						<view class="wall-card__author-info">
							<text class="wall-card__author-name">{{item.vauthor}}</text>
							<text class="wall-card__time">{{item.vtimestamp}}</text>
						</view>
					</view>
					<text class="wall-card__tag type-{{item.message_type}}">{{item.vmessage_type}}</text>
				</view>
				<view class="wall-card__title" wx:if="{{item.title}}">{{item.title}}</view>
				<view class="wall-card__content">{{item.content}}</view>
				<view wx:if="{{item.hasimage}}" class="wall-card__media">
					<t-grid column="{{4}}">
						<t-grid-item wx:for="{{item.images}}" wx:for-item="image" wx:key="*this">
							<t-image src="{{image}}" width="156" height="156"></t-image>
						</t-grid-item>
					</t-grid>
				</view>
				<view class="wall-card__meta" wx:if="{{item.location || item.contact_info}}">
					<text wx:if="{{item.location}}" class="wall-card__meta-item">📍 {{item.location}}</text>
					<text wx:if="{{item.contact_info}}" class="wall-card__meta-item">📞 {{item.contact_info}}</text>
				</view>
				<view class="wall-card__footer">
					<view class="wall-card__stats">
						<text class="wall-card__stat">👀 {{item.view_count}}</text>
						<text class="wall-card__stat" wx:if="{{item.is_like}}">❤️ {{item.like_count}}</text>
                        <text class="wall-card__stat" wx:if="{{!item.is_like}}">🤍 {{item.like_count}}</text>
					</view>
					<view class="wall-card__tags" wx:if="{{item.tags}}">
						<text class="wall-card__chip" wx:for="{{item.vtags}}" wx:key="*this">{{item}}</text>
					</view>
				</view>
			</view>
		</view>
	</block>

	<view wx:elif="{{!loading}}" class="ui-empty">暂无消息，率先发布一条分享吧</view>
</scroll-view>